// 1Cleaner for Mac. Developer ID distribution without App Sandbox: Developer Cleaner needs
// ~/Library/Developer, project folders anywhere in the home folder, the Docker CLI and xcrun simctl.
PRODUCT_NAME = 1Cleaner
PRODUCT_MODULE_NAME = OneCleanerMac
PRODUCT_BUNDLE_IDENTIFIER = app.antosha.onecleaner.mac
MARKETING_VERSION = 1.3.2
CURRENT_PROJECT_VERSION = 10

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
SUPPORTED_PLATFORMS = macosx

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = YES

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = 1Cleaner
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 Anton Trantin
INFOPLIST_KEY_NSDesktopFolderUsageDescription = 1Cleaner looks for build folders, installers and large files on your Desktop. Nothing is removed without your confirmation.
INFOPLIST_KEY_NSDocumentsFolderUsageDescription = 1Cleaner looks for build folders and large files in Documents. Nothing is removed without your confirmation.
INFOPLIST_KEY_NSDownloadsFolderUsageDescription = 1Cleaner looks for old installers and large files in Downloads. Nothing is removed without your confirmation.
INFOPLIST_KEY_NSAppleEventsUsageDescription = 1Cleaner asks Finder to empty the Trash when you choose Empty Trash.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Signed to run on this Mac only, so anyone can build from source; tools/release.sh signs releases with the
// Developer ID and its team.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
CODE_SIGN_ENTITLEMENTS = Configuration/OneCleanerMac.entitlements
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
COMBINE_HIDPI_IMAGES = YES
