    "Send only on the networks listed above. Coins sent on another network can't be recovered.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende nur über die oben aufgeführten Netzwerke. Über ein anderes Netzwerk gesendete Coins können nicht wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía solo por las redes indicadas arriba. Las monedas enviadas por otra red no se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez uniquement sur les réseaux indiqués ci-dessus. Les cryptos envoyées sur un autre réseau ne peuvent pas être récupérées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim hanya melalui jaringan yang tercantum di atas. Koin yang dikirim melalui jaringan lain tidak dapat dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia solo sulle reti elencate sopra. Le criptovalute inviate su un'altra rete non si possono recuperare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上記のネットワークでのみ送金してください。別のネットワークで送ったコインは復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에 나열된 네트워크로만 보내세요. 다른 네트워크로 보낸 코인은 복구할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstuur alleen via de netwerken hierboven. Munten die via een ander netwerk zijn verstuurd, kunnen niet worden teruggehaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłaj tylko w sieciach wymienionych powyżej. Monet wysłanych w innej sieci nie da się odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie só pelas redes listadas acima. Moedas enviadas por outra rede não podem ser recuperadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте только в сетях, перечисленных выше. Монеты, отправленные в другой сети, не вернуть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yukarıda listelenen ağlarda gönderin. Başka bir ağda gönderilen coinler kurtarılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилайте лише в мережах, перелічених вище. Монети, надіслані в іншій мережі, не повернути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ gửi qua các mạng được liệt kê ở trên. Coin gửi qua mạng khác sẽ không thể khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅通过上面列出的网络发送。通过其他网络发送的币无法找回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能透過上方列出的網路傳送。透過其他網路傳送的幣將無法找回。"
          }
        }
      }
    },
