    "Downloads couldn't be read. Allow access when macOS asks.": {
      "comment": "Note in Old Downloads; Downloads is the folder",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Downloads“ konnte nicht gelesen werden. Erlaube den Zugriff, wenn macOS fragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer Descargas. Permite el acceso cuando macOS lo pida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le dossier Téléchargements. Autorisez l'accès quand macOS le demande."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder Unduhan tidak dapat dibaca. Izinkan akses saat macOS meminta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la cartella Download. Consenti l'accesso quando macOS lo chiede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードフォルダを読み込めませんでした。macOSから確認されたときにアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 폴더를 읽을 수 없습니다. macOS가 요청할 때 접근을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads kon niet worden gelezen. Sta toegang toe als macOS erom vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać folderu Pobrane rzeczy. Zezwól na dostęp, gdy macOS zapyta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler Downloads. Permita o acesso quando o macOS pedir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать папку «Загрузки». Разрешите доступ, когда macOS спросит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler klasörü okunamadı. macOS sorduğunda erişime izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати папку «Викачане». Дозвольте доступ, коли macOS запитає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc thư mục Tải về. Hãy cho phép truy cập khi macOS hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取“下载”。请在 macOS 询问时允许访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取「下載項目」。請在 macOS 詢問時允許取用。"
          }
        }
      }
    },
