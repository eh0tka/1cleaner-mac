    "Finder couldn't empty the whole Trash: %@ Empty the Trash again or use Finder.": {
      "comment": "Empty Trash error. The placeholder is Finder's own message (a sentence).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder konnte den Papierkorb nicht ganz entleeren: %@ Entleere den Papierkorb erneut oder verwende den Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder no pudo vaciar toda la Papelera: %@ Vuelve a vaciar la Papelera o usa Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder n'a pas pu vider entièrement la corbeille : %@ Videz à nouveau la corbeille ou utilisez le Finder."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder tidak dapat mengosongkan seluruh Tong Sampah: %@ Kosongkan Tong Sampah lagi atau gunakan Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Finder non è riuscito a svuotare tutto il Cestino: %@ Svuota di nuovo il Cestino o usa il Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderでゴミ箱をすべて空にできませんでした: %@ もう一度ゴミ箱を空にするか、Finderを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder가 휴지통을 모두 비우지 못했습니다: %@ 휴지통을 다시 비우거나 Finder를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Finder kon de prullenmand niet helemaal legen: %@ Leeg de prullenmand opnieuw of gebruik de Finder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder nie opróżnił całego Kosza: %@ Opróżnij Kosz ponownie lub użyj Findera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Finder não conseguiu esvaziar todo o Lixo: %@ Esvazie o Lixo de novo ou use o Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder не смог полностью очистить Корзину: %@ Очистите Корзину снова или воспользуйтесь Finder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder Çöp Sepeti'nin tamamını boşaltamadı: %@ Çöp Sepeti'ni yeniden boşaltın veya Finder'ı kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder не зміг повністю очистити Смітник: %@ Очистьте Смітник знову або скористайтеся Finder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder không thể dọn sạch toàn bộ Thùng rác: %@ Hãy dọn sạch Thùng rác lại hoặc dùng Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达无法清倒整个废纸篓：%@ 请再次清倒废纸篓或使用访达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 無法清空整個垃圾桶：%@ 請再次清空垃圾桶或使用 Finder。"
          }
        }
      }
    },
    "Finder couldn't empty the whole Trash: %@ Quit the app that uses it and empty the Trash again.": {
      "comment": "Empty Trash error. The placeholder is Finder's own message (a sentence), a file in use.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder konnte den Papierkorb nicht ganz entleeren: %@ Beende die App, die die Datei verwendet, und entleere den Papierkorb erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder no pudo vaciar toda la Papelera: %@ Sal de la app que lo está usando y vuelve a vaciar la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder n'a pas pu vider entièrement la corbeille : %@ Quittez l'app qui l'utilise et videz à nouveau la corbeille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder tidak dapat mengosongkan seluruh Tong Sampah: %@ Keluar dari aplikasi yang menggunakannya dan kosongkan Tong Sampah lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Finder non è riuscito a svuotare tutto il Cestino: %@ Esci dall'app che lo usa e svuota di nuovo il Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderでゴミ箱をすべて空にできませんでした: %@ そのファイルを使用しているAppを終了してから、もう一度ゴミ箱を空にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder가 휴지통을 모두 비우지 못했습니다: %@ 해당 파일을 사용하는 앱을 종료하고 휴지통을 다시 비우세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Finder kon de prullenmand niet helemaal legen: %@ Stop de app die het bestand gebruikt en leeg de prullenmand opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder nie opróżnił całego Kosza: %@ Zamknij aplikację, która używa tego pliku, i opróżnij Kosz ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Finder não conseguiu esvaziar todo o Lixo: %@ Encerre o app que o está usando e esvazie o Lixo de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder не смог полностью очистить Корзину: %@ Закройте приложение, которое использует этот файл, и очистите Корзину снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder Çöp Sepeti'nin tamamını boşaltamadı: %@ Dosyayı kullanan uygulamadan çıkıp Çöp Sepeti'ni yeniden boşaltın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder не зміг повністю очистити Смітник: %@ Закрийте програму, яка використовує цей файл, і очистьте Смітник знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder không thể dọn sạch toàn bộ Thùng rác: %@ Hãy thoát ứng dụng đang dùng tệp đó và dọn sạch Thùng rác lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达无法清倒整个废纸篓：%@ 请退出正在使用它的应用，然后再次清倒废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 無法清空整個垃圾桶：%@ 請結束正在使用它的 App，然後再次清空垃圾桶。"
          }
        }
      }
    },
