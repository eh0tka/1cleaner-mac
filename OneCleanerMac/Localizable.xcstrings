          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de mappen die groot zijn door duizenden kleine bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz foldery, które urosły przez tysiące małych plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as pastas que são grandes por causa de milhares de arquivos pequenos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, какие папки разрослись из-за тысяч мелких файлов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Binlerce küçük dosya nedeniyle büyüyen klasörleri görün."
