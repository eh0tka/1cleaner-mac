    "Device backups can be listed only with Full Disk Access.": {
      "comment": "Note in the iPhone & iPad category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte-Backups können nur mit Festplattenvollzugriff aufgelistet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad de dispositivos solo se pueden listar con Acceso total al disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes d'appareils ne peuvent être listées qu'avec l'accès complet au disque."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan perangkat hanya dapat ditampilkan dengan Akses Disk Penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup dei dispositivi si possono elencare solo con l'accesso completo al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのバックアップは、フルディスクアクセスがある場合のみ一覧表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 백업은 전체 디스크 접근 권한이 있어야만 표시할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservekopieën van apparaten kunnen alleen met volledige schijftoegang worden weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie zapasowe urządzeń można wyświetlić tylko z pełnym dostępem do dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups de dispositivos só podem ser listados com o Acesso Total ao Disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии устройств видны только с полным доступом к диску."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt yedekleri yalnızca Tam Disk Erişimi ile listelenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервні копії пристроїв видно лише з повним доступом до диска."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể liệt kê bản sao lưu thiết bị khi có Quyền truy cập đầy đủ vào ổ đĩa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有开启“完全磁盘访问权限”后才能列出设备备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須有「完整磁碟取用權限」才能列出裝置備份。"
          }
        }
      }
    },
    "Device logs": {
      "comment": "Row title: logs copied from iPhones and iPads",
      "localizations": {
