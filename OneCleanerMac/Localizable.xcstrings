            "state": "translated",
            "value": "1Cleaner перейде на нову мову після перезапуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner sẽ chuyển sang ngôn ngữ mới sau khi khởi động lại."
          }
        },
        "zh-Hans": {
