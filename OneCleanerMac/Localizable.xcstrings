    "System files, other users, snapshots and data 1Cleaner can't read": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemdateien, andere Benutzer, Snapshots und Daten, die 1Cleaner nicht lesen kann"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos del sistema, otros usuarios, instantáneas y datos que 1Cleaner no puede leer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers système, autres utilisateurs, instantanés et données que 1Cleaner ne peut pas lire"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File sistem, pengguna lain, snapshot, dan data yang tidak dapat dibaca 1Cleaner"
          }
        },
        "it": {
          "stringUnit": {
