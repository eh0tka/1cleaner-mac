    "Some files in it can't be read, so the copy couldn't be checked. Nothing was changed.": {
      "comment": "Move to Another Disk error",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien darin können nicht gelesen werden, daher konnte die Kopie nicht geprüft werden. Es wurde nichts verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden leer algunos archivos que contiene, así que no se ha podido comprobar la copia. No se ha modificado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers qu'il contient ne peuvent pas être lus, la copie n'a donc pas pu être vérifiée. Rien n'a été modifié."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa file di dalamnya tidak dapat dibaca, jadi salinan tidak dapat diperiksa. Tidak ada yang diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni file al suo interno non possono essere letti, quindi non è stato possibile controllare la copia. Non è stato modificato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内部の一部のファイルを読み込めないため、コピーを確認できませんでした。何も変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내부의 일부 파일을 읽을 수 없어 사본을 확인하지 못했습니다. 아무것도 변경되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige bestanden erin kunnen niet worden gelezen, dus de kopie kon niet worden gecontroleerd. Er is niets gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać niektórych plików w środku, więc nie udało się sprawdzić kopii. Nic nie zostało zmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos dentro dele não podem ser lidos, então não foi possível verificar a cópia. Nada foi alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые файлы внутри нельзя прочитать, поэтому копию не удалось проверить. Ничего не изменено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçindeki bazı dosyalar okunamıyor, bu yüzden kopya denetlenemedi. Hiçbir şey değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі файли всередині неможливо прочитати, тому копію не вдалося перевірити. Нічого не змінено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc một số tệp bên trong, nên không thể kiểm tra bản sao. Không có gì bị thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中有些文件无法读取，因此无法检查副本。未进行任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中有些檔案無法讀取，因此無法檢查拷貝。未進行任何變更。"
          }
        }
      }
    },
    "Some folders couldn't be read. Allow access when macOS asks.": {
      "comment": "Note above a list when macOS denied access to some folders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Ordner konnten nicht gelesen werden. Erlaube den Zugriff, wenn macOS fragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer algunas carpetas. Permite el acceso cuando macOS lo pida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains dossiers n'ont pas pu être lus. Autorisez l'accès quand macOS le demande."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa folder tidak dapat dibaca. Izinkan akses saat macOS meminta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune cartelle non sono leggibili. Consenti l'accesso quando macOS lo chiede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のフォルダを読み込めませんでした。macOSから確認されたときにアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 폴더를 읽을 수 없습니다. macOS가 요청할 때 접근을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige mappen konden niet worden gelezen. Sta toegang toe als macOS erom vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać niektórych folderów. Zezwól na dostęp, gdy macOS zapyta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler algumas pastas. Permita o acesso quando o macOS pedir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать некоторые папки. Разрешите доступ, когда macOS спросит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı klasörler okunamadı. macOS sorduğunda erişime izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати деякі папки. Дозвольте доступ, коли macOS запитає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc một số thư mục. Hãy cho phép truy cập khi macOS hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分文件夹无法读取。请在 macOS 询问时允许访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分資料夾無法讀取。請在 macOS 詢問時允許取用。"
          }
        }
      }
    },
    "Some folders couldn't be read. Give 1Cleaner Full Disk Access in Settings to include them.": {
      "comment": "Note above a list when some known folders couldn't be read",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Ordner konnten nicht gelesen werden. Gib 1Cleaner in den Einstellungen Festplattenvollzugriff, um sie einzubeziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer algunas carpetas. Dale a 1Cleaner Acceso total al disco en Ajustes para incluirlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains dossiers n'ont pas pu être lus. Donnez à 1Cleaner l'accès complet au disque dans Réglages Système pour les inclure."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa folder tidak dapat dibaca. Beri 1Cleaner Akses Disk Penuh di Pengaturan untuk menyertakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune cartelle non sono leggibili. Dai a 1Cleaner l'accesso completo al disco in Impostazioni di Sistema per includerle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のフォルダを読み込めませんでした。それらを含めるには、設定で1Cleanerにフルディスクアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 폴더를 읽을 수 없습니다. 포함하려면 설정에서 1Cleaner에 전체 디스크 접근 권한을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige mappen konden niet worden gelezen. Geef 1Cleaner in Instellingen volledige schijftoegang om ze mee te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać niektórych folderów. Aby je uwzględnić, nadaj aplikacji 1Cleaner pełny dostęp do dysku w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler algumas pastas. Dê ao 1Cleaner Acesso Total ao Disco nos Ajustes para incluí-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать некоторые папки. Чтобы учесть их, предоставьте 1Cleaner полный доступ к диску в Системных настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı klasörler okunamadı. Bunları dahil etmek için Ayarlar'da 1Cleaner'a Tam Disk Erişimi verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати деякі папки. Щоб урахувати їх, надайте 1Cleaner повний доступ до диска в Системних параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc một số thư mục. Hãy cấp cho 1Cleaner Quyền truy cập đầy đủ vào ổ đĩa trong Cài đặt để tính cả chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分文件夹无法读取。请在“系统设置”中为 1Cleaner 开启“完全磁盘访问权限”以包含它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分資料夾無法讀取。請在「系統設定」中給予 1Cleaner「完整磁碟取用權限」以納入它們。"
