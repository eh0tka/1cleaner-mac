    "Two parts of it are named “%@”, so they can't go into one folder.": {
      "comment": "Move to Another Disk error. The placeholder is a file or folder name.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Teile davon heißen „%@“ und können daher nicht in denselben Ordner verschoben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos de sus partes se llaman “%@”, así que no pueden ir en la misma carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux de ses éléments s'appellent « %@ » et ne peuvent donc pas aller dans un même dossier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua bagiannya bernama “%@”, jadi keduanya tidak dapat dimasukkan ke satu folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due sue parti si chiamano “%@”, quindi non possono stare nella stessa cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前が“%@”の部分が2つあるため、同じフォルダに入れられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 ‘%@’인 항목이 두 개 있어 한 폴더에 넣을 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee onderdelen ervan heten “%@”, dus ze kunnen niet samen in één map worden geplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwie jego części mają nazwę „%@”, więc nie mogą trafić do jednego folderu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas partes dele se chamam “%@”, então não podem ficar na mesma pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две части объекта называются «%@», поэтому их нельзя поместить в одну папку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki parçasının adı “%@”, bu yüzden aynı klasöre konamazlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дві частини об’єкта мають назву «%@», тому їх не можна помістити в одну папку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai phần của mục này cùng tên “%@”, nên không thể đặt vào cùng một thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中有两个部分都名为“%@”，因此无法放入同一个文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中有兩個部分都名為「%@」，因此無法放入同一個資料夾。"
          }
        }
      }
    },
