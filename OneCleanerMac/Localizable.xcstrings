    "Disk images and installer packages in Downloads and Desktop. Keep the ones you need offline.": {
      "comment": "Explanation above the Installers list",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festplattenimages und Installationspakete in „Downloads“ und auf dem Schreibtisch. Behalte die, die du offline brauchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imágenes de disco y paquetes de instalación en Descargas y Escritorio. Conserva los que necesites sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images disque et paquets d'installation dans Téléchargements et sur le Bureau. Gardez ceux dont vous avez besoin hors ligne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Image disk dan paket penginstal di Unduhan dan Desktop. Simpan yang masih Anda perlukan saat offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagini disco e pacchetti di installazione in Download e sulla Scrivania. Tieni quelli che ti servono offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードとデスクトップにあるディスクイメージとインストーラパッケージ。オフラインで必要なものは残しておいてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 및 데스크탑에 있는 디스크 이미지와 설치 패키지. 오프라인에서 필요한 것은 남겨 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schijfkopieën en installatiepakketten in Downloads en op het bureaublad. Bewaar wat je offline nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazy dysków i pakiety instalacyjne w folderach Pobrane rzeczy i Biurko. Zachowaj te, których potrzebujesz offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens de disco e pacotes de instalação em Downloads e na Mesa. Mantenha os que você precisa offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образы дисков и установочные пакеты в папке «Загрузки» и на Рабочем столе. Оставьте те, что понадобятся без интернета."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler ve Masaüstü'ndeki disk görüntüleri ve yükleyici paketleri. Çevrimdışı gerekenleri saklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Образи дисків та інсталяційні пакети в папці «Викачане» і на Робочому столі. Залиште ті, що знадобляться без інтернету."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh đĩa và gói cài đặt trong Tải về và Màn hình nền. Hãy giữ lại những gì bạn cần dùng khi ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“下载”和“桌面”中的磁盘映像和安装包。保留你离线时需要的那些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「下載項目」和「桌面」中的磁碟映像檔和安裝套件。保留你離線時需要的那些。"
          }
        }
      }
    },
    "Docker Desktop may return freed space to macOS gradually.": {
      "comment": "Note in the Docker category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop gibt freigegebenen Speicherplatz eventuell erst nach und nach an macOS zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop puede devolver el espacio liberado a macOS de forma gradual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop peut rendre l'espace libéré à macOS progressivement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop mungkin mengembalikan ruang yang dibebaskan ke macOS secara bertahap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop potrebbe restituire a macOS lo spazio liberato in modo graduale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktopが解放された領域をmacOSに戻すまで、時間がかかる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop은 확보된 공간을 macOS에 천천히 돌려줄 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop geeft vrijgemaakte ruimte mogelijk geleidelijk terug aan macOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop może oddawać zwolnione miejsce systemowi macOS stopniowo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Docker Desktop pode devolver o espaço liberado ao macOS aos poucos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop может возвращать освобожденное место в macOS постепенно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop, boşalan alanı macOS sistemine kademeli olarak geri verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop може повертати звільнене місце в macOS поступово."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop có thể trả lại dung lượng đã giải phóng cho macOS từ từ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop 可能会逐步将释放的空间归还给 macOS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop 可能會逐步將釋放的空間還給 macOS。"
          }
