    "The copy didn't match the original (%lld of %lld files). The original wasn't changed.": {
      "comment": "Move to Another Disk error. Placeholders: files copied; files in the original.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie stimmt nicht mit dem Original überein (Dateien: %lld von %lld). Das Original wurde nicht verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The copy didn't match the original (%1$lld of %2$lld files). The original wasn't changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia no coincide con el original (archivos: %lld de %lld). El original no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie ne correspond pas à l'original (fichiers : %lld sur %lld). L'original n'a pas été modifié."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan tidak cocok dengan aslinya (%lld dari %lld file). Aslinya tidak diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia non corrisponde all'originale (file: %lld di %lld). L'originale non è stato modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーが元の項目と一致しませんでした（%lld/%lld個のファイル）。元の項目は変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사본이 원본과 일치하지 않습니다(파일 %lld/%lld개). 원본은 변경되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopie kwam niet overeen met het origineel (bestanden: %lld van %lld). Het origineel is niet gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
