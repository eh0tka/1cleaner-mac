        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Finder is de prullenmand nog aan het legen; dat rondt vanzelf af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder nadal opróżnia Kosz; zakończy to sam."
