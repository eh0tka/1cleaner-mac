          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムファイル、ほかのユーザ、スナップショット、1Cleanerが読み取れないデータ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 파일, 다른 사용자, 스냅샷 및 1Cleaner가 읽을 수 없는 데이터"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeembestanden, andere gebruikers, snapshots en gegevens die 1Cleaner niet kan lezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki systemowe, inni użytkownicy, migawki i dane, których 1Cleaner nie może odczytać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos do sistema, outros usuários, instantâneos e dados que o 1Cleaner não consegue ler"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системные файлы, другие пользователи, снимки и данные, которые 1Cleaner не может прочитать"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem dosyaları, diğer kullanıcılar, anlık görüntüler ve 1Cleaner'ın okuyamadığı veriler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системні файли, інші користувачі, знімки й дані, які 1Cleaner не може прочитати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp hệ thống, người dùng khác, snapshot và dữ liệu 1Cleaner không đọc được"
          }
        },
        "zh-Hans": {
