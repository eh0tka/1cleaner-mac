    "Choose a folder on another disk. 1Cleaner copies “%@” there, checks the copy, then moves the original to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner auf einem anderen Laufwerk. 1Cleaner kopiert „%@“ dorthin, prüft die Kopie und legt dann das Original in den Papierkorb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta en otro disco. 1Cleaner copia “%@” allí, comprueba la copia y luego traslada el original a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier sur un autre disque. 1Cleaner y copie « %@ », vérifie la copie, puis place l'original dans la corbeille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder di disk lain. 1Cleaner menyalin “%@” ke sana, memeriksa salinannya, lalu memindahkan aslinya ke Tong Sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella su un altro disco. 1Cleaner vi copia “%@”, controlla la copia, poi sposta l'originale nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のディスク上のフォルダを選択してください。1Cleanerは“%@”をそこにコピーし、コピーを確認してから元の項目をゴミ箱に入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 디스크의 폴더를 선택하세요. 1Cleaner가 그곳에 ‘%@’의 사본을 만들고 확인한 다음 원본을 휴지통으로 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map op een andere schijf. 1Cleaner kopieert “%@” daarheen, controleert de kopie en verplaatst het origineel dan naar de prullenmand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder na innym dysku. 1Cleaner skopiuje tam „%@”, sprawdzi kopię, a potem przeniesie oryginał do Kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta em outro disco. O 1Cleaner copia “%@” para lá, verifica a cópia e depois move o original para o Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку на другом диске. 1Cleaner скопирует туда «%@», проверит копию, а затем переместит оригинал в Корзину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir diskte bir klasör seçin. 1Cleaner “%@” öğesini oraya kopyalar, kopyayı denetler ve sonra orijinali Çöp Sepeti'ne taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть папку на іншому диску. 1Cleaner скопіює туди «%@», перевірить копію, а потім перемістить оригінал у Смітник."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thư mục trên ổ đĩa khác. 1Cleaner sao chép “%@” đến đó, kiểm tra bản sao, rồi chuyển bản gốc vào Thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择另一个磁盘上的文件夹。1Cleaner 会将“%@”拷贝到那里，检查副本，然后将原件移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇其他磁碟上的資料夾。1Cleaner 會將「%@」拷貝到該處、檢查拷貝，然後將原始項目丟到垃圾桶。"
          }
        }
      }
    },
