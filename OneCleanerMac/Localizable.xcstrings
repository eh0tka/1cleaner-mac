    "Scans the scan folders again; Project Builds, Git Worktrees, Large Files and Duplicates refresh together": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht die Scan-Ordner erneut; Projekt-Builds, Git-Worktrees, Große Dateien und Duplikate werden gemeinsam aktualisiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a revisar las carpetas de escaneo; “Builds de proyectos”, “Worktrees de Git”, “Archivos grandes” y “Duplicados” se actualizan a la vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réanalyse les dossiers choisis ; « Builds de projets », « Worktrees Git », « Fichiers volumineux » et « Doublons » s'actualisent ensemble"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindai ulang folder yang dipilih; Build Proyek, Worktree Git, File Besar, dan File Duplikat diperbarui bersamaan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripete la scansione delle cartelle scelte; “Build dei progetti”, “Worktree di Git”, “File grandi” e “Duplicati” si aggiornano insieme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン対象フォルダを再スキャンします。「プロジェクトのビルド」「Gitワークツリー」「大きなファイル」「重複ファイル」はまとめて更新されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 대상 폴더를 다시 스캔합니다. ‘프로젝트 빌드’, ‘Git 워크트리’, ‘대용량 파일’, ‘중복 파일’이 함께 업데이트됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorzoekt je scanmappen opnieuw; “Projectbuilds”, “Git-worktrees”, “Grote bestanden” en “Duplicaten” worden samen vernieuwd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie przeszukuje foldery do skanowania; „Buildy projektów”, „Drzewa robocze Git”, „Duże pliki” i „Duplikaty” odświeżają się razem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica de novo as suas pastas de escaneamento; Builds de Projetos, Worktrees do Git, Arquivos Grandes e Arquivos Duplicados são atualizados juntos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно сканирует папки из настроек; «Сборки проектов», «Рабочие деревья Git», «Большие файлы» и «Дубликаты» обновляются вместе"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz klasörleri yeniden tarar; Proje Derlemeleri, Git Çalışma Ağaçları, Büyük Dosyalar ve Yinelenen Dosyalar birlikte yenilenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно сканує папки з налаштувань; «Збірки проєктів», «Робочі дерева Git», «Великі файли» й «Дублікати» оновлюються разом"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét lại các thư mục đã chọn; “Bản build dự án”, “Worktree Git”, “Tệp lớn” và “Tệp trùng lặp” được làm mới cùng lúc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新扫描所选文件夹；“项目构建”“Git 工作树”“大文件”和“重复文件”会一起刷新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新掃描所選資料夾；「專案建置」、「Git 工作樹」、「大型檔案」和「重複檔案」會一起重新整理"
          }
        }
      }
    },
