    "Finder is still emptying the Trash; it finishes on its own.": {
      "comment": "Empty Trash status",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder entleert den Papierkorb noch; das läuft von selbst zu Ende."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder sigue vaciando la Papelera; terminará por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder vide encore la corbeille ; cela se termine tout seul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder masih mengosongkan Tong Sampah; prosesnya akan selesai dengan sendirinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
