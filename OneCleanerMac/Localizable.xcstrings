    "Changed in the last day; a session may be running.": {
      "comment": "Why an AI agent's session history can't be selected",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Innerhalb des letzten Tages geändert; vielleicht läuft noch eine Sitzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambió en el último día; puede haber una sesión en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifié au cours des dernières 24 heures ; une session est peut-être en cours."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diubah dalam sehari terakhir; sesi mungkin sedang berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificato nelle ultime 24 ore; una sessione potrebbe essere in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近1日以内に変更されています。セッションが実行中の可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 하루 안에 변경되었습니다. 세션이 실행 중일 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgelopen dag gewijzigd; mogelijk loopt er nog een sessie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniono w ciągu ostatniej doby; sesja może nadal trwać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterado no último dia; uma sessão pode estar em andamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменено за последние сутки; сеанс может быть активен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son bir gün içinde değişti; bir oturum çalışıyor olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінено протягом останньої доби; сеанс може бути активним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thay đổi trong ngày qua; có thể một phiên đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一天内有更改；可能有会话正在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一天內有變更；可能有工作階段正在執行。"
          }
        }
      }
    },
