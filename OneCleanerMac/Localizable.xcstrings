    "Analyze to see apps, photos, videos, developer data and more, and where they live.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiere, um Apps, Fotos, Videos, Entwicklerdaten und mehr zu sehen – und wo sie liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza para ver apps, fotos, videos, datos de desarrollo y más, y dónde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez le disque pour voir les apps, photos, vidéos, données de développement et plus encore, et leur emplacement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis untuk melihat aplikasi, foto, video, data developer, dan lainnya, serta lokasinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza per vedere app, foto, video, dati per sviluppatori e altro, e dove si trovano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析すると、App、写真、ビデオ、デベロッパデータなどと、その保存場所が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석하면 앱, 사진, 비디오, 개발자 데이터 등이 무엇이고 어디에 있는지 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyseer om apps, foto's, video's, ontwikkelaarsgegevens en meer te zien, en waar ze staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeanalizuj, aby zobaczyć aplikacje, zdjęcia, wideo, dane programistyczne i inne oraz gdzie się znajdują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise para ver apps, fotos, vídeos, dados de desenvolvimento e mais, e onde eles ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите анализ, чтобы увидеть приложения, фото, видео, данные разработки и другое — и где все это лежит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaları, fotoğrafları, videoları, geliştirici verilerini ve daha fazlasını, nerede durduklarıyla birlikte görmek için analiz edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть аналіз, щоб побачити програми, фото, відео, дані розробки та інше — і де все це лежить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân tích để xem ứng dụng, ảnh, video, dữ liệu nhà phát triển và hơn thế nữa, cùng vị trí của chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析后可查看应用、照片、视频、开发者数据等，以及它们所在的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分析後即可查看 App、照片、影片、開發者資料等內容，以及它們存放的位置。"
          }
        }
      }
    },
