    "Emptying the Trash was stopped in Finder. What was already removed is gone.": {
      "comment": "Empty Trash error",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entleeren des Papierkorbs wurde im Finder gestoppt. Bereits Entferntes ist weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo el vaciado de la Papelera en Finder. Lo que ya se eliminó no se puede recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vidage de la corbeille a été arrêté dans le Finder. Ce qui a déjà été supprimé l'est définitivement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengosongan Tong Sampah dihentikan di Finder. Apa yang sudah dihapus tidak dapat dikembalikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo svuotamento del Cestino è stato interrotto nel Finder. Ciò che è già stato rimosso non c'è più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderでゴミ箱を空にする操作が停止されました。すでに削除されたものは元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 휴지통 비우기가 중단되었습니다. 이미 삭제된 항목은 복구할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het legen van de prullenmand is in de Finder gestopt. Wat al verwijderd was, is weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opróżnianie Kosza zostało zatrzymane w Finderze. To, co już usunięto, przepadło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O esvaziamento do Lixo foi interrompido no Finder. O que já foi removido não volta mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистка Корзины была остановлена в Finder. То, что уже удалено, не вернуть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Sepeti'nin boşaltılması Finder'da durduruldu. Silinmiş olanlar geri gelmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищення Смітника зупинено у Finder. Те, що вже видалено, не повернути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc dọn sạch Thùng rác đã bị dừng trong Finder. Những gì đã xóa thì không thể khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清倒废纸篓的操作已在访达中停止。已删除的内容无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Finder 中停止清空垃圾桶。已刪除的內容無法復原。"
          }
        }
      }
    },
