    "Labels show how safe it is to delete each item. Nothing is selected for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstufungen zeigen, wie gefahrlos sich jedes Objekt löschen lässt. Nichts ist vorausgewählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas indican lo seguro que es eliminar cada elemento. No se selecciona nada automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étiquettes indiquent si chaque élément peut être supprimé sans risque. Rien n'est sélectionné à votre place."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Label menunjukkan seberapa aman menghapus setiap item. Tidak ada yang dipilihkan untuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le etichette indicano quanto è sicuro eliminare ogni elemento. Nulla viene selezionato al posto tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルは、各項目を削除しても安全かどうかを示します。自動では何も選択されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라벨은 각 항목을 삭제해도 얼마나 안전한지 보여 줍니다. 자동으로 선택되는 항목은 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels tonen hoe veilig het is om elk onderdeel te verwijderen. Er wordt niets voor je geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Etykiety pokazują, na ile bezpieczne jest usunięcie każdego elementu. Nic nie jest zaznaczane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As etiquetas mostram o quão seguro é apagar cada item. Nada é selecionado automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метки показывают, насколько безопасно удалять каждый объект. Заранее ничего не выбрано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketler, her öğeyi silmenin ne kadar güvenli olduğunu gösterir. Sizin yerinize hiçbir şey seçilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мітки показують, наскільки безпечно видаляти кожен елемент. Заздалегідь нічого не вибрано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhãn cho biết mức độ an toàn khi xóa từng mục. Không có gì được chọn sẵn cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签显示删除每个项目的安全程度。不会替你选择任何项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤顯示刪除每個項目的安全程度。不會替你選取任何項目。"
          }
        }
      }
    },
