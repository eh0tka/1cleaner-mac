    "The tool didn't answer in time.": {
      "comment": "Error when a command-line tool (docker, xcrun) times out",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tool hat nicht rechtzeitig geantwortet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La herramienta no respondió a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'outil n'a pas répondu à temps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat tidak merespons tepat waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo strumento non ha risposto in tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールが時間内に応答しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구가 제시간에 응답하지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tool reageerde niet op tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzie nie odpowiedziało na czas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ferramenta não respondeu a tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструмент не ответил вовремя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç zamanında yanıt vermedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інструмент не відповів вчасно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ không phản hồi kịp thời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具未及时响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具未及時回應。"
          }
        }
      }
    },
    "The update information isn't available right now. Try again later.": {
      "comment": "Check for Updates error",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Update-Informationen sind gerade nicht verfügbar. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información de actualizaciones no está disponible ahora. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de mise à jour ne sont pas disponibles pour le moment. Réessayez plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasi pembaruan tidak tersedia saat ini. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni sugli aggiornamenti non sono disponibili al momento. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、アップデート情報を利用できません。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 업데이트 정보를 사용할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De update-informatie is nu niet beschikbaar. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacje o uaktualnieniach są teraz niedostępne. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações de atualização não estão disponíveis agora. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Информация об обновлениях сейчас недоступна. Повторите попытку позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme bilgileri şu anda kullanılamıyor. Daha sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інформація про оновлення зараз недоступна. Спробуйте пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không có thông tin cập nhật. Hãy thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新信息暂时不可用。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法取得更新資訊。請稍後再試。"
          }
        }
      }
    },
    "The update is installed. Quit 1Cleaner and open it again to start the new version.": {
      "comment": "Shown when the update is in place but macOS couldn't start the new copy",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update ist installiert. Beende 1Cleaner und öffne die App erneut, um die neue Version zu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización está instalada. Sal de 1Cleaner y vuelve a abrirlo para iniciar la nueva versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour est installée. Quittez 1Cleaner et rouvrez-le pour lancer la nouvelle version."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan sudah diinstal. Keluar dari 1Cleaner dan buka lagi untuk memulai versi baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiornamento è installato. Esci da 1Cleaner e riaprilo per avviare la nuova versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートがインストールされました。新しいバージョンを起動するには、1Cleanerを終了してからもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트가 설치되었습니다. 새 버전을 시작하려면 1Cleaner를 종료한 후 다시 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De update is geïnstalleerd. Stop 1Cleaner en open de app opnieuw om de nieuwe versie te starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnienie zostało zainstalowane. Zakończ 1Cleaner i otwórz go ponownie, aby uruchomić nową wersję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização foi instalada. Encerre o 1Cleaner e abra-o de novo para iniciar a nova versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление установлено. Завершите 1Cleaner и откройте его снова, чтобы запустить новую версию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme yüklendi. Yeni sürümü başlatmak için 1Cleaner'dan çıkın ve uygulamayı yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення встановлено. Завершіть 1Cleaner і відкрийте його знову, щоб запустити нову версію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản cập nhật đã được cài đặt. Hãy thoát 1Cleaner và mở lại để khởi động phiên bản mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新已安装。请退出 1Cleaner 并重新打开，以启动新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新項目已安裝。請結束 1Cleaner 並重新開啟，以啟動新版本。"
          }
        }
      }
    },
    "These items don't go to the Trash: Docker removes them for good. You'll confirm them separately. A volume can hold a database: select one only if you're sure.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Objekte kommen nicht in den Papierkorb: Docker entfernt sie endgültig. Du bestätigst sie separat. Ein Volume kann eine Datenbank enthalten: Wähle es nur aus, wenn du sicher bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos elementos no van a la Papelera: Docker los elimina definitivamente. Los confirmarás por separado. Un volumen puede contener una base de datos: selecciónalo solo si estás seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments ne vont pas dans la corbeille : Docker les supprime définitivement. Vous les confirmerez séparément. Un volume peut contenir une base de données : ne le sélectionnez que si vous en êtes sûr."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini tidak masuk ke Tong Sampah: Docker menghapusnya secara permanen. Anda akan mengonfirmasinya secara terpisah. Volume bisa berisi database: pilih hanya jika Anda yakin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi elementi non vanno nel Cestino: Docker li rimuove definitivamente. Li confermerai a parte. Un volume può contenere un database: selezionalo solo se ne sei sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの項目はゴミ箱に入りません。Dockerが完全に削除します。別途確認を求められます。ボリュームにはデータベースが含まれていることがあるので、確信がある場合のみ選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목들은 휴지통으로 이동하지 않으며 Docker가 영구적으로 삭제합니다. 따로 확인하게 됩니다. 볼륨에는 데이터베이스가 있을 수 있으니 확실할 때만 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze onderdelen gaan niet naar de prullenmand: Docker verwijdert ze definitief. Je bevestigt ze apart. Een volume kan een database bevatten: selecteer het alleen als je het zeker weet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te elementy nie trafiają do Kosza: Docker usuwa je na zawsze. Potwierdzisz je osobno. Wolumin może zawierać bazę danych: zaznacz go tylko, jeśli masz pewność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes itens não vão para o Lixo: o Docker os remove de vez. Você vai confirmá-los separadamente. Um volume pode ter um banco de dados: selecione-o só se tiver certeza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти объекты не попадают в Корзину: Docker удаляет их навсегда. Вы подтвердите их отдельно. Том может содержать базу данных: выбирайте его, только если уверены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğeler Çöp Sepeti'ne gitmez: Docker onları kalıcı olarak siler. Bunları ayrıca onaylayacaksınız. Bir volume veritabanı tutabilir: yalnızca eminseniz seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці елементи не потрапляють у Смітник: Docker видаляє їх назавжди. Ви підтвердите їх окремо. Том може містити базу даних: вибирайте його, лише якщо впевнені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục này không vào Thùng rác: Docker xóa chúng vĩnh viễn. Bạn sẽ xác nhận riêng. Một volume có thể chứa cơ sở dữ liệu: chỉ chọn nếu bạn chắc chắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些项目不会移到废纸篓：Docker 会将它们永久删除。你需要单独确认。卷可能存有数据库：仅在确定时选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些項目不會丟到垃圾桶：Docker 會將它們永久刪除。你需要另外確認。磁碟區可能存有資料庫：請確定後再選取。"
          }
        }
      }
    },
