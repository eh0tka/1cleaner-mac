    "You can put them back from the Trash until you empty it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst sie aus dem Papierkorb zurücklegen, bis du ihn entleerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes recuperarlos de la Papelera hasta que la vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez les remettre depuis la corbeille tant que vous ne l'avez pas vidée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat meletakkannya kembali dari Tong Sampah sampai Anda mengosongkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi ripristinarli dal Cestino finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にするまでは、ゴミ箱から戻すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우기 전까지 휴지통에서 되돌려 놓을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ze uit de prullenmand terugzetten tot je deze leegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz je przywrócić z Kosza, dopóki go nie opróżnisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode recuperá-los do Lixo até esvaziá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их можно вернуть из Корзины, пока вы ее не очистите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Sepeti'ni boşaltana kadar onları Çöp Sepeti'nden yerine koyabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їх можна повернути зі Смітника, доки ви його не очистите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đưa chúng trở lại từ Thùng rác cho đến khi dọn sạch Thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在清倒废纸篓之前，你可以将它们从废纸篓中放回原处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
