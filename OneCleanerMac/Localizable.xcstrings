    "Taking an item off the list scans its category again, so it shows up right away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Objekt von der Liste entfernst, wird seine Kategorie erneut gescannt, damit es sofort wieder erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar un elemento de la lista vuelve a escanear su categoría, así que aparece de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer un élément de la liste réanalyse sa catégorie, il réapparaît donc aussitôt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeluarkan item dari daftar akan memindai kategorinya lagi, sehingga item itu langsung muncul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togliere un elemento dall'elenco ripete la scansione della sua categoria, così riappare subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストから項目を外すとそのカテゴリが再スキャンされるので、すぐに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 항목을 제거하면 해당 카테고리를 다시 스캔하므로 바로 나타납니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een onderdeel van de lijst haalt, wordt de categorie opnieuw gescand, zodat het meteen weer verschijnt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie elementu z listy ponownie skanuje jego kategorię, więc od razu się pojawi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover um item da lista escaneia a categoria dele de novo, então ele aparece na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если убрать объект из списка, его категория сканируется заново, и он сразу появится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeden bir öğeyi çıkarmak kategorisini yeniden tarar; böylece hemen görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо прибрати елемент зі списку, його категорія сканується заново, і він одразу з’явиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ một mục khỏi danh sách sẽ quét lại danh mục của nó, nên mục đó xuất hiện ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从列表中移除某个项目会重新扫描其类别，因此它会立即出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從清單移除項目時會重新掃描其類別，因此它會立即出現。"
          }
        }
      }
    },
