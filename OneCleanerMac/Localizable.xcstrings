          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopya orijinalle eşleşmedi (%lld / %lld dosya). Orijinal değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія не збіглася з оригіналом (файлів: %lld з %lld). Оригінал не змінено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
