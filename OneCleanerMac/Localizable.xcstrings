    "%@ is selected here. Clean it now, or clear the selection and go on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier hast du %@ ausgewählt. Bereinige die Auswahl jetzt oder hebe sie auf und mach weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí hay %@ seleccionados. Límpialos ahora o quita la selección y continúa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez sélectionné %@ ici. Nettoyez maintenant, ou désélectionnez et continuez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dipilih di sini. Bersihkan sekarang, atau kosongkan pilihan lalu lanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui hai selezionato %@. Pulisci ora oppure deseleziona e continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで %@ が選択されています。今すぐクリーンアップするか、選択を解除して続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 선택된 항목은 %@입니다. 지금 정리하거나 선택을 해제하고 계속하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier is %@ geselecteerd. Ruim het nu op, of hef de selectie op en ga verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczono tu %@. Wyczyść teraz albo odznacz i przejdź dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há %@ selecionados aqui. Limpe agora ou desmarque tudo e continue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь выбрано %@. Очистите сейчас или снимите выбор и продолжайте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada %@ seçili. Şimdi temizleyin veya seçimi kaldırıp devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут вибрано %@. Очистьте зараз або зніміть вибір і продовжуйте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã chọn %@ ở đây. Hãy dọn dẹp ngay, hoặc bỏ chọn và tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处已选择 %@。现在清理，或取消全部选择后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處已選取 %@。現在清理，或取消全部選取後繼續。"
          }
        }
      }
    },
    "%@ isn't installed; its chats, settings and caches are here": {
      "comment": "AI Agents row note; %@ is an agent name (Claude, Cursor…)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht installiert; Chats, Einstellungen und Caches liegen noch hier"
          }
        },
        "es": {
