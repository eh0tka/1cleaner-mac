          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosz opróżnia się przyciskiem „Opróżnij Kosz”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lixo é esvaziado com Esvaziar Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Корзина очищается кнопкой «Очистить Корзину»."
          }
        },
        "tr": {
