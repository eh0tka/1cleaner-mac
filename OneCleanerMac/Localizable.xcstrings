    "Its path goes through a symbolic link.": {
      "comment": "Why an item can't be moved to the Trash",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Pfad führt über einen symbolischen Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su ruta pasa por un enlace simbólico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son chemin passe par un lien symbolique."
          }
        },
