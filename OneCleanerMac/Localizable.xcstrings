    "Docker isn't running. Start Docker and scan again to see its containers and images.": {
      "comment": "Note in the Docker category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker läuft nicht. Starte Docker und scanne erneut, um Container und Images zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker no está en ejecución. Abre Docker y vuelve a escanear para ver sus contenedores e imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker n'est pas lancé. Lancez Docker et analysez à nouveau pour voir ses conteneurs et ses images."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker tidak berjalan. Jalankan Docker dan pindai lagi untuk melihat kontainer dan image-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker non è in esecuzione. Avvia Docker e ripeti la scansione per vedere i suoi container e le sue immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockerが実行されていません。Dockerを起動して再スキャンすると、コンテナとイメージが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker가 실행 중이 아닙니다. Docker를 시작하고 다시 스캔하면 컨테이너와 이미지를 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker is niet actief. Start Docker en scan opnieuw om de containers en images te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker nie działa. Uruchom aplikację Docker i przeskanuj ponownie, aby zobaczyć jej kontenery i obrazy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Docker não está em execução. Abra o Docker e escaneie de novo para ver os contêineres e imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker не запущен. Запустите Docker и повторите сканирование, чтобы увидеть его контейнеры и образы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker çalışmıyor. Konteynerlerini ve imajlarını görmek için Docker'ı başlatıp yeniden tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker не запущено. Запустіть Docker і проскануйте знову, щоб побачити його контейнери й образи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker không chạy. Hãy khởi động Docker và quét lại để xem các container và image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 未运行。请启动 Docker 并重新扫描，以查看其容器和镜像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 未執行。請啟動 Docker 並重新掃描，以查看其容器和映像檔。"
          }
        }
      }
    },
    "Docker now uses a different setup than during the scan. Scan again.": {
      "comment": "Cleanup failure reason: the Docker context changed since the scan",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ist jetzt anders eingerichtet als beim Scan. Scanne erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ahora usa una configuración distinta de la del escaneo. Vuelve a escanear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker n'est plus configuré comme lors de l'analyse. Analysez à nouveau."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker kini memakai pengaturan yang berbeda dari saat pemindaian. Pindai lagi."
