    "The downloaded update didn't pass the check. This copy wasn't changed.": {
      "comment": "Install and Relaunch error",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heruntergeladene Update hat die Prüfung nicht bestanden. Diese Kopie von 1Cleaner wurde nicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización descargada no ha superado la comprobación. Esta copia de 1Cleaner no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de la mise à jour téléchargée a échoué. Cette copie de 1Cleaner n'a pas été modifiée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan yang diunduh tidak lolos verifikasi. Salinan 1Cleaner ini tidak diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiornamento scaricato non ha superato la verifica. Questa copia di 1Cleaner non è stata modificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたアップデートは検証に失敗しました。使用中の1Cleanerは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 업데이트가 검증을 통과하지 못했습니다. 사용 중인 1Cleaner는 변경되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gedownloade update heeft de controle niet doorstaan. Deze kopie van 1Cleaner is niet gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrane uaktualnienie nie przeszło weryfikacji. Ta kopia aplikacji 1Cleaner nie została zmieniona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização baixada não passou na verificação. Esta cópia do 1Cleaner não foi alterada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачанное обновление не прошло проверку. Эта копия 1Cleaner не изменена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen güncelleme doğrulamayı geçemedi. 1Cleaner'ın bu kopyası değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажене оновлення не пройшло перевірку. Цю копію 1Cleaner не змінено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản cập nhật đã tải về không vượt qua bước xác minh. Bản sao 1Cleaner này không bị thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的更新未通过校验。当前的 1Cleaner 未更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載的更新項目未通過驗證。目前的 1Cleaner 未變更。"
          }
        }
      }
    },
    "The original changed while it was copied. Nothing was changed; try again.": {
      "comment": "Move to Another Disk error",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original hat sich beim Kopieren geändert. Es wurde nichts verändert; versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original cambió mientras se copiaba. No se ha modificado nada; inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'original a changé pendant la copie. Rien n'a été modifié ; réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aslinya berubah saat sedang disalin. Tidak ada yang diubah; coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'originale è cambiato durante la copia. Non è stato modificato nulla; riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー中に元の項目が変更されました。何も変更されていません。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사하는 동안 원본이 변경되었습니다. 아무것도 변경되지 않았습니다. 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het origineel veranderde tijdens het kopiëren. Er is niets gewijzigd; probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginał zmienił się podczas kopiowania. Nic nie zostało zmienione; spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O original mudou enquanto era copiado. Nada foi alterado; tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригинал изменился во время копирования. Ничего не изменено; повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal, kopyalanırken değişti. Hiçbir şey değiştirilmedi; yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригінал змінився під час копіювання. Нічого не змінено; спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản gốc đã thay đổi trong lúc sao chép. Không có gì bị thay đổi; hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝期间原件发生了更改。未进行任何更改；请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝期間原始項目有所變更。未進行任何變更；請再試一次。"
          }
        }
      }
    },
    "The original stays where it is until the copy is checked; then it goes to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original bleibt, wo es ist, bis die Kopie geprüft ist; dann kommt es in den Papierkorb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original se queda donde está hasta que se comprueba la copia; después va a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'original reste en place jusqu'à la vérification de la copie, puis il va dans la corbeille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aslinya tetap di tempatnya sampai salinannya diperiksa; setelah itu aslinya masuk ke Tong Sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'originale resta dov'è finché la copia non viene controllata; poi va nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の項目はコピーの確認が終わるまでそのまま残り、その後ゴミ箱に入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 사본 확인이 끝날 때까지 그대로 있다가 휴지통으로 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het origineel blijft staan tot de kopie is gecontroleerd; daarna gaat het naar de prullenmand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginał zostaje na miejscu, dopóki kopia nie zostanie sprawdzona; potem trafia do Kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O original fica onde está até a cópia ser verificada; depois vai para o Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригинал остается на месте, пока копия не проверена; затем он отправляется в Корзину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopya denetlenene kadar orijinal yerinde kalır; ardından Çöp Sepeti'ne gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригінал залишається на місці, доки копію не перевірено; потім він відправляється в Смітник."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản gốc vẫn ở nguyên chỗ cho đến khi bản sao được kiểm tra; sau đó bản gốc được chuyển vào Thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在副本检查完成之前，原件保留在原处；之后会移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始項目會保留在原處，直到拷貝檢查完成；之後才會丟到垃圾桶。"
          }
        }
      }
    },
