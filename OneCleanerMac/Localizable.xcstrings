    "See the folders that are big because of thousands of small files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir die Ordner an, die durch Tausende kleine Dateien groß geworden sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué carpetas ocupan mucho espacio por tener miles de archivos pequeños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez les dossiers devenus volumineux à cause de milliers de petits fichiers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
