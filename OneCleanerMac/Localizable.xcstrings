    "%@ freed. Support 1Cleaner?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ freigegeben. 1Cleaner unterstützen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liberados. ¿Quieres apoyar 1Cleaner?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libérés. Soutenir 1Cleaner ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dibebaskan. Dukung 1Cleaner?"
          }
        },
        "it": {
