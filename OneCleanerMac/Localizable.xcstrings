    "That folder is on the same disk, so moving there frees no space. Choose another disk.": {
      "comment": "Move to Another Disk error",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner liegt auf demselben Laufwerk, Verschieben gibt also keinen Platz frei. Wähle ein anderes Laufwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa carpeta está en el mismo disco, así que trasladar allí no libera espacio. Elige otro disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est sur le même disque : y déplacer l'élément ne libère pas d'espace. Choisissez un autre disque."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder itu berada di disk yang sama, jadi memindahkan ke sana tidak membebaskan ruang. Pilih disk lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella cartella è sullo stesso disco, quindi spostarci l'elemento non libera spazio. Scegli un altro disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのフォルダは同じディスク上にあるため、移動しても空き容量は増えません。別のディスクを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 폴더는 같은 디스크에 있어 이동해도 공간이 확보되지 않습니다. 다른 디스크를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die map staat op dezelfde schijf, dus verplaatsen maakt geen ruimte vrij. Kies een andere schijf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder jest na tym samym dysku, więc przeniesienie tam nie zwolni miejsca. Wybierz inny dysk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pasta está no mesmo disco, então mover para lá não libera espaço. Escolha outro disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка на том же диске, поэтому перемещение туда не освободит место. Выберите другой диск."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör aynı diskte; oraya taşımak yer açmaz. Başka bir disk seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка на тому самому диску, тож переміщення туди не звільнить місця. Виберіть інший диск."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục đó nằm trên cùng ổ đĩa, nên di chuyển đến đó không giải phóng dung lượng. Hãy chọn ổ đĩa khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件夹位于同一磁盘，移到那里不会释放空间。请选择另一个磁盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該資料夾位於同一個磁碟，移到那裡無法釋放空間。請選擇其他磁碟。"
          }
        }
      }
    },
    "The Trash is emptied with Empty Trash.": {
      "comment": "Cleanup failure reason. Empty Trash is the button's title.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Papierkorb wird mit „Papierkorb entleeren“ entleert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Papelera se vacía con Vaciar la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La corbeille se vide avec Vider la corbeille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tong Sampah dikosongkan dengan Kosongkan Tong Sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Cestino si svuota con Svuota il Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱は「ゴミ箱を空にする」で空にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통은 '휴지통 비우기'로 비웁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
