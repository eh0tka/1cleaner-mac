        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔하면 여기에 있는 항목을 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan om te zien wat hier staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeskanuj, aby zobaczyć, co tu jest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie para ver o que há aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
