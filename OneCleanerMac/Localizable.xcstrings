    "Docker is set to use another computer. 1Cleaner cleans only Docker on this Mac.": {
      "comment": "Note in the Docker category when the Docker context points to a remote daemon",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ist so eingestellt, dass es einen anderen Computer verwendet. 1Cleaner bereinigt Docker nur auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker está configurado para usar otro equipo. 1Cleaner limpia Docker solo en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker est configuré pour utiliser un autre ordinateur. 1Cleaner ne nettoie que le Docker de ce Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker diatur untuk memakai komputer lain. 1Cleaner hanya membersihkan Docker yang ada di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker è impostato per usare un altro computer. 1Cleaner pulisce Docker solo su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockerは別のコンピュータを使用するように設定されています。1CleanerはこのMac上のDockerのみをクリーンアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker가 다른 컴퓨터를 사용하도록 설정되어 있습니다. 1Cleaner는 이 Mac의 Docker만 정리합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker is ingesteld om een andere computer te gebruiken. 1Cleaner ruimt Docker alleen op deze Mac op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker jest ustawiony tak, by używać innego komputera. 1Cleaner czyści Dockera tylko na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Docker está configurado para usar outro computador. O 1Cleaner limpa só o Docker deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker настроен на работу с другим компьютером. 1Cleaner очищает Docker только на этом Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker başka bir bilgisayarı kullanacak şekilde ayarlanmış. 1Cleaner yalnızca bu Mac'teki Docker'ı temizler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker налаштовано на роботу з іншим комп’ютером. 1Cleaner очищає Docker лише на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker đang được thiết lập để dùng một máy tính khác. 1Cleaner chỉ dọn dẹp Docker trên máy Mac này."
          }
