          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ve iPad Yedekleri"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервні копії iPhone та iPad"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu iPhone & iPad"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 与 iPad 备份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 與 iPad 備份"
          }
        }
      }
    },
    "iPhone and iPad backups made by Finder, and downloaded iOS updates. A backup may be the only copy of a device's data: remove it only if you have a newer one or iCloud Backup.": {
      "comment": "Explanation above the iPhone & iPad list. iCloud Backup is Apple's feature name.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Finder erstellte iPhone- und iPad-Backups sowie geladene iOS-Updates. Ein Backup kann die einzige Kopie der Daten eines Geräts sein: Entferne es nur, wenn du ein neueres Backup oder ein iCloud-Backup hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias de seguridad de iPhone y iPad hechas con Finder y actualizaciones de iOS descargadas. Una copia de seguridad puede ser la única copia de los datos de un dispositivo: elimínala solo si tienes una más reciente o usas Copia en iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardes d'iPhone et d'iPad faites par le Finder, et mises à jour iOS téléchargées. Une sauvegarde peut être la seule copie des données d'un appareil : ne la supprimez que si vous en avez une plus récente ou la sauvegarde iCloud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan iPhone dan iPad yang dibuat oleh Finder, serta pembaruan iOS yang diunduh. Cadangan mungkin satu-satunya salinan data perangkat: hapus hanya jika Anda punya cadangan yang lebih baru atau Cadangan iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup di iPhone e iPad creati dal Finder e aggiornamenti iOS scaricati. Un backup può essere l'unica copia dei dati di un dispositivo: rimuovilo solo se ne hai uno più recente o il backup di iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderで作成したiPhoneとiPadのバックアップ、およびダウンロード済みのiOSアップデート。バックアップはデバイスのデータの唯一のコピーである場合があります。より新しいバックアップまたはiCloudバックアップがある場合にのみ削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder로 만든 iPhone 및 iPad 백업과 다운로드된 iOS 업데이트. 백업이 기기 데이터의 유일한 사본일 수 있으니 더 새로운 백업이나 iCloud 백업이 있을 때만 삭제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservekopieën van iPhone en iPad die met de Finder zijn gemaakt, en gedownloade iOS-updates. Een reservekopie kan de enige kopie zijn van de gegevens van een apparaat: verwijder deze alleen als je een nieuwere hebt of iCloud-reservekopie gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie zapasowe iPhone'a i iPada utworzone przez Findera oraz pobrane uaktualnienia iOS. Kopia zapasowa może być jedyną kopią danych urządzenia: usuń ją tylko, jeśli masz nowszą lub Kopię zapasową iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups de iPhone e iPad feitos pelo Finder e atualizações do iOS baixadas. Um backup pode ser a única cópia dos dados de um dispositivo: remova-o só se tiver um mais recente ou usar o Backup do iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии iPhone и iPad, созданные в Finder, и загруженные обновления iOS. Резервная копия может быть единственной копией данных устройства: удаляйте ее, только если у вас есть более новая копия или включено резервное копирование iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder ile yapılan iPhone ve iPad yedekleri ve indirilmiş iOS güncellemeleri. Bir yedek, aygıt verilerinin tek kopyası olabilir: yalnızca daha yeni bir yedeğiniz varsa veya iCloud Yedekleme kullanıyorsanız silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервні копії iPhone та iPad, створені у Finder, і завантажені оновлення iOS. Резервна копія може бути єдиною копією даних пристрою: видаляйте її, лише якщо маєте новішу копію або ввімкнено резервне копіювання iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu iPhone và iPad do Finder tạo, cùng các bản cập nhật iOS đã tải về. Bản sao lưu có thể là bản sao duy nhất của dữ liệu thiết bị: chỉ xóa nếu bạn có bản mới hơn hoặc Sao lưu iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由访达创建的 iPhone 和 iPad 备份，以及已下载的 iOS 更新。备份可能是设备数据的唯一副本：仅在你有更新的备份或 iCloud 云备份时才删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Finder 製作的 iPhone 和 iPad 備份，以及已下載的 iOS 更新項目。備份可能是裝置資料的唯一拷貝：只有在你有較新的備份或 iCloud 備份時才刪除。"
          }
        }
      }
    },
