    "It changed since the scan. Scan again.": {
      "comment": "Why an item can't be moved to the Trash",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit dem Scan geändert. Scanne erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambió desde el escaneo. Vuelve a escanear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a changé depuis l'analyse. Analysez à nouveau."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini berubah sejak pemindaian. Pindai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È cambiato dopo la scansione. Ripeti la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン後に変更されました。再スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 이후 변경되었습니다. 다시 스캔하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is gewijzigd sinds de scan. Scan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniło się od skanowania. Przeskanuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele mudou desde o escaneamento. Escaneie de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объект изменился после сканирования. Повторите сканирование."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taramadan sonra değişti. Yeniden tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елемент змінився після сканування. Проскануйте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
