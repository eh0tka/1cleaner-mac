          "stringUnit": {
            "state": "translated",
            "value": "查看因數千個小檔案而變大的資料夾。"
          }
        }
      }
    },
    "See what kind of data fills your disk and where it lives.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, welche Daten deinen Speicher füllen und wo sie liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué tipo de datos llenan tu disco y dónde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez quel type de données remplit votre disque et où elles se trouvent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat jenis data apa yang memenuhi disk Anda dan di mana lokasinya."
