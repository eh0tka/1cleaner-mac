    "Includes Poetry's virtual environments; `poetry install` creates them again": {
      "comment": "Row detail",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält die virtuellen Umgebungen von Poetry; `poetry install` erstellt sie neu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye los entornos virtuales de Poetry; `poetry install` los vuelve a crear"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
