    "Largest files; files under %@ count only in the totals.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größte Dateien; Dateien unter %@ zählen nur in den Summen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos más grandes; los archivos de menos de %@ solo cuentan en los totales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers les plus volumineux ; ceux de moins de %@ ne comptent que dans les totaux."
