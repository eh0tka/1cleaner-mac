    "Folders where thousands of files under %@ add up to %@ or more. A listed folder can hold another listed folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner, in denen Tausende Dateien unter %@ zusammen %@ oder mehr belegen. Ein aufgeführter Ordner kann einen weiteren aufgeführten Ordner enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Folders where thousands of files under %1$@ add up to %2$@ or more. A listed folder can hold another listed folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas donde miles de archivos de menos de %@ suman %@ o más. Una carpeta de la lista puede contener otra carpeta de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossiers où des milliers de fichiers de moins de %@ totalisent %@ ou plus. Un dossier listé peut en contenir un autre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder dengan ribuan file di bawah %@ yang totalnya mencapai %@ atau lebih. Folder dalam daftar bisa berisi folder lain dalam daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartelle in cui migliaia di file sotto %@ occupano in tutto %@ o più. Una cartella dell’elenco può contenerne un’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@未満のファイルが数千個あり、合計が%@以上になるフォルダです。一覧のフォルダが、別の一覧のフォルダを含んでいることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 미만의 파일 수천 개가 합쳐서 %@ 이상인 폴더입니다. 목록의 폴더가 목록의 다른 폴더를 포함할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen waarin duizenden bestanden kleiner dan %@ samen %@ of meer innemen. Een map in de lijst kan een andere map uit de lijst bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldery, w których tysiące plików mniejszych niż %@ zajmują razem %@ lub więcej. Folder z listy może zawierać inny folder z listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas em que milhares de arquivos com menos de %@ somam %@ ou mais. Uma pasta da lista pode conter outra pasta da lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки, где тысячи файлов размером меньше %@ в сумме занимают %@ или больше. Папка из списка может содержать другую папку из списка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ altındaki binlerce dosyanın toplamda %@ veya daha fazla yer kapladığı klasörler. Listedeki bir klasör, listedeki başka bir klasörü içerebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки, де тисячі файлів менших за %@ разом займають %@ або більше. Папка зі списку може містити іншу папку зі списку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thư mục mà hàng nghìn tệp dưới %@ cộng lại chiếm từ %@ trở lên. Một thư mục trong danh sách có thể chứa thư mục khác trong danh sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小于 %@ 的数千个文件合计达到 %@ 或以上的文件夹。列表中的文件夹可能包含另一个已列出的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裡面有數千個小於 %@ 的檔案、合計達 %@ 以上的資料夾。列出的資料夾可能包含另一個列出的資料夾。"
          }
        }
      }
    },
