    "Opened attachments; the messages keep the originals": {
      "comment": "Detail of the Mail attachment copies row",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geöffnete Anhänge; die Originale bleiben in den E-Mails"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjuntos abiertos; los mensajes conservan los originales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pièces jointes ouvertes ; les messages conservent les originaux"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampiran yang dibuka; pesan tetap menyimpan aslinya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allegati aperti; i messaggi conservano gli originali"
          }
        },
        "ja": {
          "stringUnit": {
