    "Scan to see what's here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne, um zu sehen, was hier ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea para ver qué hay aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez une analyse pour voir ce qu'il y a ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai untuk melihat isinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una scansione per vedere cosa c'è qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンすると、ここにある内容が表示されます。"
          }
