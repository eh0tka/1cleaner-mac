    "Xcode isn't installed, so there are no simulators to manage.": {
      "comment": "Note in the Simulators category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode ist nicht installiert, daher gibt es keine Simulatoren zu verwalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode no está instalado, así que no hay simuladores que gestionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode n'est pas installé : il n'y a aucun simulateur à gérer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode tidak terinstal, jadi tidak ada simulator untuk dikelola."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode non è installato, quindi non ci sono simulatori da gestire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcodeがインストールされていないため、管理するシミュレータはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode가 설치되어 있지 않아 관리할 시뮬레이터가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode is niet geïnstalleerd, dus er zijn geen simulators om te beheren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode nie jest zainstalowany, więc nie ma symulatorów do zarządzania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Xcode não está instalado, então não há simuladores para gerenciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode не установлен, поэтому симуляторов нет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode yüklü değil, bu yüzden yönetilecek simülatör yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode не встановлено, тому симуляторів немає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode chưa được cài đặt, nên không có simulator nào để quản lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装 Xcode，因此没有可管理的模拟器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未安裝 Xcode，因此沒有可管理的模擬器。"
          }
        }
      }
    },
    "Xcode removes both for good, they don't go to the Trash. Running simulators can't be removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode entfernt beides endgültig, es kommt nicht in den Papierkorb. Laufende Simulatoren können nicht entfernt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode elimina ambos definitivamente; no van a la Papelera. Los simuladores en ejecución no se pueden eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode supprime les deux définitivement, ils ne vont pas dans la corbeille. Les simulateurs en cours d'exécution ne peuvent pas être supprimés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode menghapus keduanya secara permanen, tidak masuk ke Tong Sampah. Simulator yang sedang berjalan tidak dapat dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode li rimuove entrambi definitivamente, non vanno nel Cestino. I simulatori in esecuzione non si possono rimuovere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcodeはどちらも完全に削除し、ゴミ箱には入りません。実行中のシミュレータは削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode는 둘 다 영구적으로 삭제하며 휴지통으로 이동하지 않습니다. 실행 중인 시뮬레이터는 삭제할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode verwijdert beide definitief, ze gaan niet naar de prullenmand. Actieve simulators kunnen niet worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode usuwa jedno i drugie na zawsze, nie trafiają do Kosza. Działających symulatorów nie można usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Xcode remove ambos de vez; eles não vão para o Lixo. Simuladores em execução não podem ser removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode удаляет и то и другое навсегда, в Корзину они не попадают. Запущенные симуляторы удалить нельзя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode ikisini de kalıcı olarak siler, Çöp Sepeti'ne gitmezler. Çalışan simülatörler silinemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode видаляє і те, і інше назавжди, у Смітник вони не потрапляють. Запущені симулятори видалити не можна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode xóa vĩnh viễn cả hai, chúng không vào Thùng rác. Không thể xóa simulator đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 会将两者永久删除，不会移到废纸篓。正在运行的模拟器无法删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 會將兩者永久刪除，不會丟到垃圾桶。執行中的模擬器無法刪除。"
          }
        }
      }
    },
