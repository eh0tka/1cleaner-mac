    "1Cleaner checks only when you ask. It reads one file on onebuckapps.com and sends nothing about your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner prüft nur, wenn du es möchtest. Dabei wird eine Datei auf onebuckapps.com gelesen und nichts über deinen Mac gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner solo comprueba cuando se lo pides. Lee un archivo en onebuckapps.com y no envía nada sobre tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner ne vérifie que lorsque vous le demandez. Il lit un seul fichier sur onebuckapps.com et n'envoie rien sur votre Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner hanya memeriksa saat Anda memintanya. Aplikasi ini membaca satu file di onebuckapps.com dan tidak mengirim apa pun tentang Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner controlla solo quando lo chiedi tu. Legge un solo file su onebuckapps.com e non invia nulla sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleanerは、指示されたときだけ確認します。onebuckapps.com上のファイルを1つ読み込むだけで、Macに関する情報は何も送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner는 요청할 때만 확인합니다. onebuckapps.com의 파일 하나만 읽으며 Mac에 대한 정보는 아무것도 보내지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner controleert alleen als je erom vraagt. Het leest één bestand op onebuckapps.com en verstuurt niets over je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner sprawdza tylko na żądanie. Odczytuje jeden plik z onebuckapps.com i nie wysyła żadnych danych o tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O 1Cleaner só verifica quando você pede. Ele lê um arquivo em onebuckapps.com e não envia nada sobre o seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner проверяет только по вашему запросу. Он читает один файл на onebuckapps.com и ничего не отправляет о вашем Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner yalnızca siz istediğinizde denetler. onebuckapps.com'daki tek bir dosyayı okur ve Mac'iniz hakkında hiçbir şey göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner перевіряє лише на ваш запит. Він читає один файл на onebuckapps.com і нічого не надсилає про ваш Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner chỉ kiểm tra khi bạn yêu cầu. Ứng dụng đọc một tệp trên onebuckapps.com và không gửi bất kỳ thông tin nào về máy Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner 仅在你要求时检查。它只读取 onebuckapps.com 上的一个文件，不会发送任何关于你的 Mac 的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1Cleaner 只會在你要求時檢查。它只讀取 onebuckapps.com 上的一個檔案，不會傳送任何關於你 Mac 的資訊。"
          }
        }
      }
    },
